PORT=5000
NODE_ENV=development

# Supabase Database (Source of Truth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Airtable (Dashboard / Sync UI)
AIRTABLE_TOKEN=pat_your_airtable_token
AIRTABLE_BASE_ID=app_your_base_id
AIRTABLE_TABLE_NAME=Outreach

# Email Sending (Provider-Agnostic SMTP via Nodemailer)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM_EMAIL=shahid@gmail.com
MAIL_FROM_NAME=Shahid

# Gmail (Incoming Reply Detection)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:5000/auth/google/callback
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token

# AI Classification (OpenAI Structured Outputs)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# Outreach Configuration & Rules
DAILY_SEND_LIMIT=10
FOLLOWUP_1_DAYS=7
FOLLOWUP_2_DAYS=14
SEND_DELAY_MS=2000

# Security & Operations
ADMIN_API_KEY=your_secure_admin_api_key
UNSUBSCRIBE_JWT_SECRET=your_jwt_unsubscribe_secret
WEBHOOK_SECRET=your_webhook_secret
BASE_URL=http://localhost:5000
